{
  "name": "@stackline/multiselect",
  "version": "1.1.6",
  "description": "Framework-agnostic vanilla JavaScript multiselect dropdown with headless state APIs, skins, object data, body overlays, and accessibility-focused keyboard/ARIA tested behavior.",
  "type": "commonjs",
  "main": "src/stackline-multiselect.js",
  "types": "types/stackline-multiselect.d.ts",
  "style": "src/stackline-multiselect.css",
  "unpkg": "dist/stackline-multiselect.js",
  "jsdelivr": "dist/stackline-multiselect.js",
  "keywords": [
    "stackline",
    "npm-package",
    "multiselect",
    "javascript",
    "typescript",
    "dropdown",
    "select",
    "combobox",
    "listbox",
    "headless",
    "search",
    "keyboard-navigation",
    "accessibility",
    "aria",
    "browser",
    "framework-agnostic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-multiselect.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-multiselect/issues"
  },
  "homepage": "https://alexandro.net/docs/multiselect/",
  "license": "MIT",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-release.cjs",
    "verify:copies": "node scripts/verify-copies.cjs",
    "verify:reproducible": "node scripts/verify-reproducible.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:static": "node --test tests/static-smoke.test.cjs",
    "test:runtime": "node --test tests/runtime.test.cjs",
    "test:types:3.9": "node node_modules/typescript39/lib/tsc.js --project tests/types/tsconfig.json",
    "test:types:latest": "node node_modules/typescript/lib/tsc.js --project tests/types/tsconfig.json",
    "test:types": "npm run test:types:3.9 && npm run test:types:latest",
    "pack:check": "node scripts/pack-check.cjs",
    "check": "npm run build && npm run verify:reproducible && npm run verify:copies && npm test && npm run test:types && npm run pack:check",
    "prepack": "npm run build && npm run verify:copies"
  },
  "files": [
    "dist/stackline-multiselect.js",
    "dist/stackline-multiselect.css",
    "dist/direct-example.html",
    "dist/README.md",
    "dist/stackline-multiselect-1.1.4.zip",
    "src/stackline-multiselect.js",
    "src/stackline-multiselect.css",
    "types",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "fflate": "0.8.3",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "typescript39": "npm:typescript@3.9.10",
    "vite": "8.3.1"
  }
}
